    <string name="settings_battery_saver_title">BATTERY SAVER POLICY</string>
    <string name="settings_battery_saver_subtitle">What to do when Battery Saver activates</string>
    <string name="settings_battery_stop">STOP</string>
    <string name="settings_battery_pause">PAUSE</string>
    <string name="settings_battery_ignore">IGNORE</string>
    <string name="settings_battery_saver_dialog_title">Battery saver policy</string>
    <string name="settings_battery_saver_dialog_body">
        Chooses what the rotation service does while Android\'s Battery Saver is active.
        \n\nStop shuts the service down completely until you start it again yourself.
        \nPause keeps the service alive but stops swapping wallpapers making it consume close to no battery,
        resuming automatically when Battery Saver turns off.
        Ignore keeps rotating normally.
    </string>
    <string name="settings_destination_title">WALLPAPER DESTINATION</string>
    <string name="settings_destination_subtitle">Apply to your lock screen, home screen or both</string>
    <!-- Shown in place of the subtitle above while the selector is greyed out, so the reason is on
         screen rather than only behind the info dialog. -->
    <string name="settings_destination_subtitle_atmosphere">Atmosphere effect always covers both screens</string>
    <string name="settings_destination_lock">LOCK</string>
    <string name="settings_destination_home">HOME</string>
    <string name="settings_destination_both">BOTH</string>
    <string name="settings_destination_dialog_title">Wallpaper destination</string>
    <string name="settings_destination_dialog_body">
        Selects which screen receive the rotating wallpapers: the lock screen, the home screen, or both.
        The screen not selected keeps whatever wallpaper it already has.
        \n\nAtmosphere effect uses both screens regardless of this setting.
    </string>
    <string name="settings_quality_high_label">STANDARD QUALITY</string>
    <string name="settings_quality_high_subtitle">For most images</string>
    <string name="settings_quality_high_dialog_title">Standard quality</string>
    <string name="settings_quality_high_dialog_body" formatted="false">
        The compression quality used when the app saves its own copy of a normal-sized image (up to 2 MB).
        Higher values keep more detail but use more storage. The recommended value is 95% as the copy is visually indistinguishable from the original.
    </string>
    <string name="settings_quality_low_label">REDUCED QUALITY</string>
    <string name="settings_quality_low_subtitle">For heavy images</string>
    <string name="settings_quality_low_dialog_title">Reduced quality</string>
    <string name="settings_quality_low_dialog_body" formatted="false">
        The compression quality used for heavy images (over 2 MB), where stronger compression saves the most storage.
        Lower values saves more storage at the cost of the fine detail. The recommended value is 80% for saving meaningful storage while not losing too much detail.
    </string>
    <string name="settings_section_storage">STORAGE</string>
    <string name="settings_keep_local_copies_title">KEEP LOCAL COPIES</string>
    <string name="settings_keep_local_copies_subtitle">Copy added photos into app storage</string>
    <string name="settings_keep_local_copies_locked_subtitle">Without photo access, photos are always copied</string>
    <string name="settings_keep_local_copies_partial_subtitle">With partial access, photos are always copied</string>
    <string name="settings_keep_local_copies_dialog_title">Keep local copies</string>
    <string name="settings_keep_local_copies_dialog_body">
        Normally the app uses your picked photos directly from where they live, storing no duplicates, but a wallpaper breaks if its original is moved or deleted.
        \n\nWith this on, the app saves its own compressed copy of every photo, so wallpapers keep working no matter what happens to the originals, at the cost of storage space.
        Without photo access permission, copies are always kept regardless of this setting to have background access to them.
    </string>
    <string name="settings_storage_usage_title">STORAGE USED</string>
    <!-- %1$s = formatted size (e.g. "142 MB"), %2$s = pluralized image count -->
