    <!-- Boot toggle -->
    <string name="settings_autostart_title">AUTOSTART ON BOOT</string>
    <string name="settings_autostart_subtitle">Resume service after reboot</string>
    <string name="settings_autostart_dialog_title">Autostart on boot</string>
    <string name="settings_autostart_dialog_body">
        When enabled, the rotation service starts again automatically after the phone reboots, as long as it was running before shutdown.
        When disabled, you need to open the app and start it manually after every reboot.
    </string>

    <!-- Wallpaper rotation -->
    <string name="settings_rotation_policy_title">WALLPAPER ROTATION</string>
    <string name="settings_rotation_policy_subtitle">How often the wallpaper changes</string>
    <string name="settings_rotation_policy_dialog_title">Wallpaper rotation</string>
    <string name="settings_rotation_policy_dialog_body">
        Sets the cadence used by every collection that doesn\'t carry its own.
        \n\nPer lock changes the wallpaper each time you lock the phone. A time interval changes it
        once that much time has passed, counted from the last change, so time with the screen off
        counts too. Daily changes it once per day, on the first rotation after midnight.
        \n\nAn interval can also change the wallpaper while you are using the phone, but only when the
        wallpaper is set to the home screen. With lock-screen-only wallpapers the change always waits
        for the next lock.
        \n\nCollections you had already given a frequency of their own keep it. Open a collection and
        switch it to GLOBAL for it to follow this setting.
    </string>

    <!-- Screen off delay -->
    <string name="settings_screen_off_delay_title">SCREEN OFF DELAY</string>
    <string name="settings_screen_off_delay_subtitle">Delay for screen off animation</string>
    <string name="settings_screen_off_delay_unit" translatable="false">ms</string>
    <string name="settings_screen_off_delay_dialog_title">Screen off delay</string>
    <string name="settings_screen_off_delay_dialog_body">
        The wallpaper is swapped when the screen turns off, but it can take a bit to fully turn off if there is a screen-off animation.
        This delay waits for that animation to finish before applying the change, so the swap is never visible.
        If the screen wakes up during the delay, the swap is canceled.
        \n\n%1$d ms by default for your phone.
    </string>

    <!-- Lockscreen zoom fix -->
    <string name="settings_zoom_fix_title">WALLPAPER ZOOM FIX</string>
    <string name="settings_zoom_fix_subtitle">Fixes Nothing OS wallpaper autozoom</string>
    <string name="settings_zoom_fix_off">OFF</string>
    <string name="settings_zoom_fix_blur">BLUR</string>
    <string name="settings_zoom_fix_edge">EDGE</string>
    <string name="settings_zoom_fix_dialog_title">Wallpaper zoom fix</string>
    <string name="settings_zoom_fix_dialog_body">
        Certain phone operating systems (like Nothing OS) automatically zoom in on wallpapers to create a parallax effect.
        This setting adds hidden padding to your image, ensuring the OS crops the padding rather than the wallpaper itself.
        \n\nBecause this zoom behavior varies, two padding styles are available in case it doesn\'t apply: choose Blur for most cases,
         or Edge for sharper borders.
    </string>
