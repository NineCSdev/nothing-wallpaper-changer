# Copy to keystore.properties (gitignored) and fill in. Never commit the filled copy.
# Every value may instead come from the environment, which takes second place:
#   storeFile     -> ANDROID_KEYSTORE_FILE      (path, relative to the repo root)
#   storePassword -> ANDROID_KEYSTORE_PASSWORD
#   keyAlias      -> ANDROID_KEY_ALIAS
#   keyPassword   -> ANDROID_KEY_PASSWORD
# With none of them set, assembleRelease still runs but emits an UNSIGNED apk.
storeFile=keystore
storePassword=
keyAlias=
keyPassword=
